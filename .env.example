# Lead capture configuration.
# DEV: copy this file to ".env.local" (gitignored) and fill in real values.
# PROD: set these in Hostinger cPanel -> Setup Node.js App -> your app ->
#       "Environment variables", then redeploy.
# NEVER put real secrets in this file -- it is committed to git.

# --- MySQL (hPanel -> Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Email: Gmail SMTP ---
# Use a Google "App Password" (Google Account -> Security -> 2-Step Verification
# -> App passwords), NOT your normal Gmail password. Enter it with no spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
MAIL_FROM=Ecomm Wizards Leads <you@gmail.com>
MAIL_TO_TEAM=you@gmail.com

# --- Admin dashboard (/admin/leads) Basic Auth ---
# NOTE: these are read by middleware (Edge) and bake into the build, so they
# must be present when `npm run build` runs on the server. Change = rebuild.
ADMIN_USER=admin
ADMIN_PASSWORD=

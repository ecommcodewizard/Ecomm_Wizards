{
  "name": "ecom-wiz-v2",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 90",
    "edge >= 90",
    "firefox >= 90",
    "safari >= 15",
    "ios_saf >= 15",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "geo:check": "tsx scripts/geo/run-all.ts",
    "geo:validate": "tsx scripts/geo/validate-content.ts",
    "geo:forbidden": "tsx scripts/geo/check-forbidden.ts",
    "geo:schema": "tsx scripts/geo/check-schema.ts",
    "geo:links": "tsx scripts/geo/check-links.ts",
    "geo:shingles": "tsx scripts/geo/check-shingles.ts",
    "geo:velocity": "tsx scripts/geo/velocity.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "framer-motion": "^12.38.0",
    "mysql2": "^3.22.5",
    "next": "^15.5.23",
    "nodemailer": "^9.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
